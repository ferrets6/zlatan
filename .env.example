# Copy to .env and fill in. The secret values are also saved to
# tank/docker-config/_sistema/env/ by the nightly backup.
#
# The required variables are ZLATAN_TRUSTED_PROXY, ZLATAN_TOKEN_KEY and — if
# the bind is public — ZLATAN_PROXY_SECRET. The service refuses to start when
# one of them is missing, and reports all of them at once.

TZ=Europe/Rome

# --- Network and access ---
# The network whose forward-auth Remote-User header (who the person is) may be
# believed. The Docker edge network. Without it, every request is refused.
ZLATAN_TRUSTED_PROXY=172.18.0.0/16

# A secret shared with Caddy: Caddy injects it on the way in, and the backend
# refuses anyone who does not carry it. Without it, a container on the edge
# network could reach the service directly and skip Caddy and the SSO. Generate
# with `openssl rand -hex 32` and put the same value in services/caddy/.env.
ZLATAN_PROXY_SECRET=

# --- Token encryption key ---
# Encrypts the OAuth refresh tokens at rest (AES-GCM). Generate with
# `openssl rand -hex 32`. LOSING IT means every stored token becomes
# unreadable and any migration in flight must be re-authorised. It lives only
# here and in tank/docker-config/_sistema/env/.
ZLATAN_TOKEN_KEY=

# --- Google OAuth client (dedicated to this service, not shared with
#     integration_google). Scope: drive.readonly. ---
ZLATAN_GOOGLE_CLIENT_ID=
ZLATAN_GOOGLE_CLIENT_SECRET=
ZLATAN_GOOGLE_REDIRECT_URL=https://zlatan.feretti.link/oauth/google/callback

# The folder Google Takeout creates in the person's own Drive when they pick
# "Add to Drive". Zlatan watches for it with the drive.readonly token it
# already holds, so there is no folder to share and no central account.
ZLATAN_TAKEOUT_FOLDER=Takeout

# How often the watcher looks for the Takeout folder, and how long it keeps
# looking before telling the person to use the upload route instead. Takeout
# takes hours to days; Google's own link is valid for about 7 days.
ZLATAN_TAKEOUT_POLL=10m
ZLATAN_TAKEOUT_MAX_WAIT=168h

# --- Destination providers ---
# Nextcloud. There is NO admin account here: the write credential is a per-user
# app password obtained through Nextcloud's Login Flow v2 (the person grants
# access with one click, behind SSO), so the import runs with exactly the
# person's own rights and Zlatan stores nothing more.
#
# Two addresses, and they are not interchangeable:
#   _URL         internal, what rclone writes to (not reachable from a browser)
#   _PUBLIC_URL  the name a person opens; the wizard links to it and shows it
# Leave the public one empty and the wizard shows no link, rather than a link
# that cannot work.
ZLATAN_NEXTCLOUD_URL=http://nextcloud
ZLATAN_NEXTCLOUD_PUBLIC_URL=https://cloud.example.org

# Immich. There is NO API key here, on purpose: Immich has no admin endpoint
# that mints a key for another account, and a single shared key would file
# every person's photos under its owner. Each person creates their own key in
# Immich and hands it to the wizard, which validates it and seals it per
# person. The public URL is where the wizard sends them to create that key.
ZLATAN_IMMICH_URL=http://immich_server:2283
ZLATAN_IMMICH_PUBLIC_URL=https://immich.example.org

# --- Notifications ---
# ntfy, so a person is told when a migration finishes or stops. Without it the
# service still runs; it just does not tell anybody. Topic and token must match
# the homelab's ntfy (services/monitoring).
ZLATAN_NTFY_URL=http://ntfy:80
ZLATAN_NTFY_TOPIC=
ZLATAN_NTFY_TOKEN=

# --- Behaviour ---
# Days a completed migration's staging is kept before the automatic purge.
ZLATAN_STAGING_RETENTION_DAYS=14

# --- Quota warning ---
# A person's personal budget in GiB across Nextcloud and Immich, matching
# docs/quotas.md (100 for a user, 200 for an admin). Zlatan cannot read LLDAP,
# so the default applies to everyone and the two admins are listed explicitly
# as "user=200,user=200". This is only ever a warning: before the Drive copy
# Zlatan reads the source size and the person's current Nextcloud usage and
# says if the copy would go past the budget. It never blocks.
ZLATAN_QUOTA_BUDGET_GIB=100
ZLATAN_QUOTA_OVERRIDES=marco-sso=200,federico-sso=200
# How many heavy migrations may run at once (1: this is a single-node homelab
# and Immich's own jobs already saturate the CPU).
ZLATAN_MAX_CONCURRENT=1
