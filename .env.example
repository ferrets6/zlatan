# Copiare in .env e riempire. I valori dei segreti vengono salvati anche in
# tank/docker-config/_sistema/env/ dal backup notturno.
#
# Le variabili obbligatorie sono ZLATAN_TRUSTED_PROXY, ZLATAN_TOKEN_KEY e —
# se il bind è pubblico — ZLATAN_PROXY_SECRET. Il servizio rifiuta di partire
# se una di queste manca, e lo dice tutte in una volta.

TZ=Europe/Rome

# --- Rete e accesso ---
# Rete da cui fidarsi dell'header forward-auth Remote-User (chi è l'utente).
# Rete edge di Docker. Senza, ogni richiesta è rifiutata.
ZLATAN_TRUSTED_PROXY=172.18.0.0/16

# Segreto condiviso con Caddy: lo inietta Caddy verso la superficie interna, e
# il backend rifiuta chi non lo porta. Senza, un container sulla rete edge
# potrebbe saltare Caddy e l'SSO. Generare con `openssl rand -hex 32` e
# mettere lo stesso valore nel .env di services/caddy.
ZLATAN_PROXY_SECRET=

# --- Chiave di cifratura dei token ---
# Cifra i refresh token OAuth a riposo (AES-GCM). Generare con
# `openssl rand -hex 32`. PERDERLA = tutti i token illeggibili, le migrazioni
# in corso vanno ri-autorizzate. Sta solo qui e in tank/docker-config/_sistema/env/.
ZLATAN_TOKEN_KEY=

# --- Client OAuth Google (dedicato a questo servizio, non condiviso con
#     integration_google). Scope: drive.readonly. ---
ZLATAN_GOOGLE_CLIENT_ID=
ZLATAN_GOOGLE_CLIENT_SECRET=
ZLATAN_GOOGLE_REDIRECT_URL=https://zlatan.feretti.link/oauth/google/callback

# Account Google di famiglia su cui gli utenti condividono il Takeout
# (variante A). L'utente vede questo indirizzo nel wizard.
ZLATAN_TAKEOUT_SHARE_ACCOUNT=

# --- Provider di destinazione ---
# Nextcloud: admin senza 2FA (come Nuno). Import via WebDAV o copia diretta
# + occ, da decidere.
ZLATAN_NEXTCLOUD_URL=http://nextcloud
ZLATAN_NEXTCLOUD_ADMIN_USER=
ZLATAN_NEXTCLOUD_ADMIN_PASSWORD=

# Immich: API key con permessi di upload.
ZLATAN_IMMICH_URL=http://immich_server:2283
ZLATAN_IMMICH_API_KEY=

# --- Comportamento ---
# Giorni di retention dello staging prima del purge automatico.
ZLATAN_STAGING_RETENTION_DAYS=14
# Numero massimo di migrazioni pesanti in parallelo (1: l'homelab è un
# single-node e i job di Immich sono già affamati di CPU).
ZLATAN_MAX_CONCURRENT=1
